{
  "name": "adastat-backend",
  "description": "AdaStat Cardano Blockchain Explorer - backend",
  "version": "2.0.0",
  "author": "AdaStat Team <info@adastat.net> (https://adastat.net/)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prod": "NODE_ENV=production tsx --env-file=.env index.ts",
    "debug": "LOG_LEVEL=debug tsx --env-file=.env index.ts",
    "trace": "LOG_LEVEL=trace tsx --env-file=.env index.ts",
    "watch": "LOG_LEVEL=debug tsx watch --env-file=.env index.ts --clear-screen=false",
    "build": "tsup index.ts --format esm --clean",
    "start": "NODE_ENV=production node --env-file=.env dist/index.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write ./lib/**/*.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --env-file=.env tests/integration"
  },
  "dependencies": {
    "@cardanowall/poe-standard": "^0.11.0",
    "@cardanowall/sdk-ts": "^0.11.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fastify/websocket": "^11.3.1",
    "bech32": "^2.0.0",
    "blake2b": "^2.1.4",
    "bs58": "^6.0.0",
    "cbor": "^10.0.12",
    "dompurify": "^3.4.15",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "markdown-it": "^14.3.2",
    "markdown-it-texmath": "^1.0.0",
    "maxmind": "^5.0.7",
    "pg": "^8.23.0",
    "pg-listen": "^1.7.0",
    "pino": "^10.3.1",
    "punycode": "^2.3.1",
    "sharp": "^0.35.4",
    "undici": "^8.10.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/blake2b": "^2.1.3",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/punycode": "^2.1.4",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-disable-autofix": "^6.1.1",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}