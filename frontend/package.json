{
  "name": "adastat-frontend",
  "description": "AdaStat Cardano Blockchain Explorer - frontend",
  "version": "2.0.0",
  "author": "AdaStat Team <info@adastat.net> (https://adastat.net/)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mainnet",
    "dev:preprod": "vite --mode preprod",
    "dev:preview": "vite --mode preview",
    "dev-force": "vite --force --mode mainnet",
    "dev-force:preprod": "vite --force --mode preprod",
    "dev-force:preview": "vite --force --mode preview",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:preprod": "run-p type-check \"build-only:preprod {@}\" --",
    "build:preview": "run-p type-check \"build-only:preview {@}\" --",
    "preview": "vite preview --mode mainnet",
    "preview:preprod": "vite preview --mode preprod",
    "preview:preview": "vite preview --mode preview",
    "build-only": "vite build --mode mainnet",
    "build-only:preprod": "vite build --mode preprod",
    "build-only:preview": "vite build --mode preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@cardanowall/crypto-core": "^0.12.0",
    "@noble/hashes": "^2.2.0",
    "chart.js": "^4.5.1",
    "countup.js": "^2.10.1",
    "d3-hierarchy": "^3.1.2",
    "katex": "^0.18.1",
    "matter-js": "^0.20.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.1.5",
    "vite-plugin-minify": "^3.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.8"
  }
}